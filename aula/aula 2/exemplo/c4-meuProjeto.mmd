C4Container
    title Sistema da Biblioteca - Diagrama de Contêineres C4

    Person(usuario, "Usuário", "Pessoa que consulta o catálogo e realiza empréstimos.")
    Person(bibliotecario, "Bibliotecário", "Responsável pela administração da biblioteca.")

    System_Ext(email, "Serviço de E-mail", "Serviço externo para envio de mensagens.")
    System_Ext(identidade, "Provedor de Identidade", "Serviço externo de autenticação.")

    System_Boundary(sistema, "Sistema da Biblioteca") {
        Container(appUsuario, "Aplicação do Usuário", "Web/Mobile", "Permite pesquisar livros, solicitar empréstimos e consultar o histórico.")
        Container(appBiblioteca, "Aplicação da Biblioteca", "Web", "Permite administrar livros, usuários, empréstimos e devoluções.")
        Container(api, "API da Biblioteca", "Java/Spring Boot", "Expõe as regras de negócio e os endpoints do sistema.")
        Container(auth, "Serviço de Autenticação", "Componente da API", "Controla login, perfis e permissões de acesso.")
        Container(catalogo, "Serviço de Catálogo", "Componente da API", "Gerencia livros, autores, categorias e disponibilidade.")
        Container(emprestimos, "Serviço de Empréstimos", "Componente da API", "Controla reservas, empréstimos, renovações e devoluções.")
        Container(notificacoes, "Serviço de Notificações", "Worker/Serviço", "Processa e envia alertas sobre prazos e devoluções.")
        Container(relatorios, "Serviço de Relatórios", "Componente da API", "Gera relatórios administrativos e indicadores.")
        ContainerDb(banco, "Banco de Dados", "PostgreSQL", "Armazena usuários, livros, empréstimos, reservas e auditoria.")
        ContainerDb(cache, "Cache", "Redis", "Armazena consultas frequentes e sessões temporárias.")
        Container(job, "Agendador de Prazos", "Job agendado", "Identifica empréstimos próximos do vencimento ou atrasados.")
    }

    Rel(usuario, appUsuario, "Usa", "HTTPS")
    Rel(bibliotecario, appBiblioteca, "Usa", "HTTPS")
    Rel(appUsuario, api, "Consome", "REST/JSON")
    Rel(appBiblioteca, api, "Consome", "REST/JSON")
    Rel(api, auth, "Valida acesso")
    Rel(api, catalogo, "Consulta e atualiza catálogo")
    Rel(api, emprestimos, "Gerencia empréstimos")
    Rel(api, relatorios, "Solicita relatórios")
    Rel(auth, identidade, "Autentica usuários", "OAuth 2.0/OIDC")
    Rel(auth, banco, "Consulta perfis e permissões", "SQL")
    Rel(catalogo, banco, "Lê e grava livros", "SQL")
    Rel(catalogo, cache, "Consulta dados frequentes")
    Rel(emprestimos, banco, "Lê e grava empréstimos", "SQL")
    Rel(relatorios, banco, "Consulta dados", "SQL")
    Rel(job, emprestimos, "Verifica prazos")
    Rel(job, notificacoes, "Solicita notificações")
    Rel(notificacoes, email, "Envia mensagens", "SMTP/API")

