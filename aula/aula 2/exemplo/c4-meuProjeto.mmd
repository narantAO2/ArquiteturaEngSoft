C4Component
    title API da Biblioteca - Diagrama de Componentes C4

    Container(appUsuario, "Aplicação do Usuário", "Web/Mobile", "Interface do usuário.")
    Container(appBiblioteca, "Aplicação da Biblioteca", "Web", "Interface administrativa.")
    ContainerDb(banco, "Banco de Dados", "PostgreSQL", "Dados persistidos do sistema.")
    Container_Ext(email, "Serviço de E-mail", "SMTP/API", "Envio de mensagens.")

    Container_Boundary(api, "API da Biblioteca") {
        Component(rotas, "Controladores REST", "Spring MVC", "Recebem requisições HTTP e retornam respostas JSON.")
        Component(authController, "Controlador de Autenticação", "Componente", "Processa login, tokens e permissões.")
        Component(catalogoController, "Controlador de Catálogo", "Componente", "Disponibiliza pesquisa e manutenção de livros.")
        Component(emprestimoController, "Controlador de Empréstimos", "Componente", "Gerencia reservas, empréstimos, renovações e devoluções.")
        Component(relatorioController, "Controlador de Relatórios", "Componente", "Disponibiliza relatórios para o bibliotecário.")
        Component(regras, "Serviço de Regras de Negócio", "Componente", "Valida disponibilidade, limites e prazos.")
        Component(repositorios, "Repositórios", "Spring Data JPA", "Persistem e consultam informações no banco.")
        Component(eventos, "Publicador de Eventos", "Mensageria interna", "Publica eventos para notificações e auditoria.")
    }

    Rel(appUsuario, rotas, "Faz requisições", "HTTPS/JSON")
    Rel(appBiblioteca, rotas, "Faz requisições", "HTTPS/JSON")
    Rel(rotas, authController, "Encaminha autenticação")
    Rel(rotas, catalogoController, "Encaminha consultas de catálogo")
    Rel(rotas, emprestimoController, "Encaminha operações de empréstimo")
    Rel(rotas, relatorioController, "Encaminha relatórios")
    Rel(authController, regras, "Valida credenciais e permissões")
    Rel(catalogoController, regras, "Executa regras do catálogo")
    Rel(emprestimoController, regras, "Executa regras de empréstimo")
    Rel(relatorioController, repositorios, "Consulta dados")
    Rel(regras, repositorios, "Lê e grava entidades")
    Rel(regras, eventos, "Publica eventos")
    Rel(repositorios, banco, "Consulta e persiste", "SQL")
    Rel(eventos, email, "Aciona notificações", "SMTP/API")
